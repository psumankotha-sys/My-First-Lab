pipeline {
    agent any

    stages {
        stage('Deploy Nagios via Helm') {
            steps {
                bat '''
                    @echo off
                    helm repo add cetic https://cetic.github.io/helm-charts
                    helm repo update
                    kubectl create namespace nagios --dry-run=client -o yaml | kubectl apply -f -
                    
                    REM Point to values.yaml inside the Nagios-Helml directory
                    helm upgrade --install nagios cetic/nagios --namespace nagios -f Nagios-Helml/values.yaml
                '''
            }
        }
    }
}